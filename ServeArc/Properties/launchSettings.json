{
  "profiles": {
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080"
      },
      "publishAllPorts": true,
      "useSSL": true
    },
    "tar": {
      "commandName": "Project",
      "commandLineArgs": "C:\\temp\\test.tar",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5140"
    },
    "zip (multi)": {
      "commandName": "Project",
      "commandLineArgs": "/SR C:\\temp\\test1.zip C:\\temp\\test2.zip",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5140"
    },
    "tar (gzip)": {
      "commandName": "Project",
      "commandLineArgs": "C:\\temp\\test.tgz",
      "launchBrowser": true,
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5140"
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}